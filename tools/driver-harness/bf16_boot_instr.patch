+    /* BF16 research instrumentation: what the FMC actually parses at cold boot. */
+    if (pKernelGsp->pWprMeta != NULL)
+    {
+        GspFwWprMeta *pWprMeta = pKernelGsp->pWprMeta;
+
+        NV_PRINTF(LEVEL_ERROR,
+                  "BF16: WprMeta magic=0x%llx rev=%llu flags=0x%x bootCount=%llu\n",
+                  pWprMeta->magic, pWprMeta->revision,
+                  (NvU32)pWprMeta->flags, pWprMeta->bootCount);
+        NV_PRINTF(LEVEL_ERROR,
+                  "BF16: WprMeta radix3Elf{addr=0x%llx size=%llu} "
+                  "bootloader{addr=0x%llx size=%llu} "
+                  "gspFw{start=0x%llx heapOff=0x%llx heapSize=0x%llx} "
+                  "frts{off=0x%llx size=0x%llx} wprEnd=0x%llx fbSize=0x%llx\n",
+                  pWprMeta->sysmemAddrOfRadix3Elf, pWprMeta->sizeOfRadix3Elf,
+                  pWprMeta->sysmemAddrOfBootloader, pWprMeta->sizeOfBootloader,
+                  pWprMeta->gspFwWprStart, pWprMeta->gspFwHeapOffset,
+                  pWprMeta->gspFwHeapSize, pWprMeta->frtsOffset,
+                  pWprMeta->frtsSize, pWprMeta->gspFwWprEnd, pWprMeta->fbSize);
+    }
+
     Spdm *pSpdm = GPU_GET_SPDM(pGpu);
 
     if (pSpdm != NULL && pSpdm->getProperty(pSpdm, PDB_PROP_SPDM_ENABLED))
