+/* BF16_CTXDUMP_BEGIN */
+/*
+ * Research-only: dump an initialized GR context buffer to /dev/shm.
+ * Read-only; the buffer is mapped through memdescMap and unmapped immediately.
+ * Enabled by the driver-harness/dump_ctx.sh harness.
+ */
+extern NV_STATUS osOpenWriteFile(const char *path, void **ppFile);
+extern NV_STATUS osWriteToFile(void *pFile, NvU8 *pBuffer, NvU64 size, NvU64 offset);
+extern void      osCloseFile(void *pFile);
+extern NvS32     os_snprintf(char *buf, NvU32 size, const char *fmt, ...);
+
+#define BF16_CTXDUMP_BYTES 8192
+#define BF16_CTXDUMP_FILE_MAX 0x400000
+#define BF16_CTXDUMP_DMESG 0
+#define BF16_CTXDUMP_MAIN_OFFSET 0
+#define BF16_CTXDUMP_CREATE 0
+#define BF16_CTXDUMP_MAX   8
+#define BF16_CTXDUMP_EXIT_MAX 2
+#define BF16_CTXDUMP_PATCH_EXIT_MAX 2
+#define BF16_CTXDUMP_GLOBAL 1
+#define BF16_CTXDUMP_GLOBAL_MAX 6
+
+static NvU32 bf16CtxDumpSeq = 0;
+static NvU32 bf16CtxDumpExitSeq = 0;
+static NvU32 bf16CtxDumpPatchExitSeq = 0;
+static NvU32 bf16CtxDumpGlobalCount = 0;
+static NvBool bf16CtxDumpGlobalDone[GR_GLOBALCTX_BUFFER_COUNT];
+
+static void
+bf16WriteFile
+(
+    const char *path,
+    const void *buf,
+    NvU64       len
+)
+{
+    void     *pFile = NULL;
+    NV_STATUS status;
+
+    status = osOpenWriteFile(path, &pFile);
+    if (status != NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR, "BF16: ctxdump file open failed %s status=%#x\n",
+                  path, status);
+        return;
+    }
+
+    status = osWriteToFile(pFile, (NvU8 *)buf, len, 0);
+    if (status != NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR, "BF16: ctxdump file write failed %s status=%#x\n",
+                  path, status);
+    }
+    osCloseFile(pFile);
+}
+
+static void
+bf16DumpCtxBuffer
+(
+    OBJGPU            *pGpu,
+    const char        *tag,
+    NvU32              seq,
+    MEMORY_DESCRIPTOR *pMemDesc,
+    NvU64              start
+)
+{
+    NvU64      size;
+    NvU64      dumpSize;
+#if BF16_CTXDUMP_DMESG
+    NvU64      off;
+#endif
+    NvU64      phys;
+    NvP64      pAddr = 0;
+    NvP64      pPriv = 0;
+    NV_STATUS  status;
+    NvU8      *p;
+
+    if (pMemDesc == NULL)
+        return;
+
+    size     = memdescGetSize(pMemDesc);
+    phys     = memdescGetPhysAddr(pMemDesc, AT_GPU, 0);
+    if (start >= size)
+        return;
+    dumpSize = size - start;
+    if (dumpSize > (NvU64)BF16_CTXDUMP_FILE_MAX)
+        dumpSize = (NvU64)BF16_CTXDUMP_FILE_MAX;
+    dumpSize &= ~(NvU64)0xF;
+
+    if (dumpSize == 0)
+        return;
+
+    status = memdescMap(pMemDesc, start, dumpSize, NV_TRUE, NV_PROTECT_READABLE,
+                        &pAddr, &pPriv);
+    if (status != NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "BF16: ctxdump %s seq=%u size=%llu phys=0x%llx map_status=0x%x\n",
+                  tag, seq, size, phys, status);
+        return;
+    }
+
+    p = (NvU8 *)NvP64_VALUE(pAddr);
+    {
+        char path[160];
+
+        os_snprintf(path, sizeof(path), "/dev/shm/bf16_ctxdump_%s_%u_%u.bin",
+                    tag, pGpu->gpuInstance, seq);
+        bf16WriteFile(path, p, dumpSize);
+        NV_PRINTF(LEVEL_ERROR,
+                  "BF16: ctxdump %s seq=%u size=%llu phys=0x%llx dump=%llu file=%s\n",
+                  tag, seq, size, phys, dumpSize, path);
+    }
+
+#if BF16_CTXDUMP_DMESG
+    for (off = 0; off < dumpSize; off += 16)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "BF16CTX %s %u %08llx:"
+                  " %02x%02x%02x%02x %02x%02x%02x%02x"
+                  " %02x%02x%02x%02x %02x%02x%02x%02x\n",
+                  tag, seq, start + off,
+                  p[off + 0],  p[off + 1],  p[off + 2],  p[off + 3],
+                  p[off + 4],  p[off + 5],  p[off + 6],  p[off + 7],
+                  p[off + 8],  p[off + 9],  p[off + 10], p[off + 11],
+                  p[off + 12], p[off + 13], p[off + 14], p[off + 15]);
+    }
+#endif
+
+    memdescUnmap(pMemDesc, NV_TRUE, pAddr, pPriv);
+}
+/* BF16_CTXDUMP_END */
