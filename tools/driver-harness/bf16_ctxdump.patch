+NV_STATUS NV_API_CALL os_open_write_file
+(
+    const char *filename,
+    void **ppFile
+)
+{
+#if NV_FILESYSTEM_ACCESS_AVAILABLE
+    struct file *file;
+
+    if ((filename == NULL) || (ppFile == NULL))
+        return NV_ERR_INVALID_ARGUMENT;
+
+    file = filp_open(filename, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+    if (IS_ERR(file))
+        return NV_ERR_OPERATING_SYSTEM;
+
+    *ppFile = (void *)file;
+    return NV_OK;
+#else
+    return NV_ERR_NOT_SUPPORTED;
+#endif
+}
